# Copy to .env and fill in values.
# API keys only - all other knobs live in Settings / pipeline_settings.yaml.
# Assign provider + model per role in llm.yaml (or Settings → Configure LLMs).
# A key is required at runtime only for providers that llm.yaml actually uses.

GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROK_API_KEY=
# OPENROUTER_API_KEY=
# Optional OpenRouter app attribution (leaderboards); omit if unused.
# OPENROUTER_HTTP_REFERER=https://genbounty.com
# OPENROUTER_APP_TITLE=Genbounty LLM Hunter

# Optional: Genbounty platform submit (Export tab; JSON export needs none of these).
# Host is hardcoded to https://genbounty.com. Batch size/retries: Settings → Pipeline.
# GENBOUNTY_API_KEY=
# GENBOUNTY_USER_ID=

# Optional: target LLM API keys from Connect Target → API key.
# Written automatically as TARGET_API_KEY_<SITE>_<COMPONENT>=...
# Example: TARGET_API_KEY_ANTHROPIC_CLAUDE5=

